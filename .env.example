# Base URL used to build NFC sticker tap links (https://your-domain/tap/<token>)
# when there's no browser `window` yet (server render) or before hydration
# has corrected it to the real origin. Not required for the app to function
# — TapHabit has no backend and no other environment variables.
#
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# Production (set this in Vercel's Environment Variables to your deployed
# domain, e.g.):
# NEXT_PUBLIC_APP_URL=https://tap-habit.vercel.app
